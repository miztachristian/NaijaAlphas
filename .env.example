TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Seconds to wait for a reply. A cold load of a 7B model on CPU can exceed 2 min.
OLLAMA_TIMEOUT=300
# How long Ollama keeps the model in RAM after a reply (avoids cold reloads).
OLLAMA_KEEP_ALIVE=30m
